{
  "name": "pmltextmod",
  "scripts": {
    "build:js": "esbuild assets/src/js/main.mod.jsx --bundle --outfile=1.0.0/main.mod.js --jsx=automatic --minify --format=esm --external:https://cdn.polymodloader.com/* --define:process.env.NODE_ENV=\\\"production\\\"",
    "build:css": "tailwindcss -i assets/src/css/mod.css -o 1.0.0/mod.css --minify",
    "build": "npm run build:js && npm run build:css",
    "watch:js": "esbuild assets/src/js/main.mod.jsx --bundle --outfile=1.0.0/main.mod.js --jsx=automatic --format=esm --external:https://cdn.polymodloader.com/* --watch",
    "watch:css": "tailwindcss -i assets/src/css/mod.css -o 1.0.0/mod.css --watch",
    "dev": "npm run watch:js & npm run watch:css"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.20.0",
    "tailwindcss": "^3.4.0"
  }
}